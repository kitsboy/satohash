{
  "manifest_version": 3,
  "name": "Satohash Snapper",
  "version": "1.0.0",
  "description": "One-click cryptographic notarization of any web content. Stamp + Save to Bitcoin.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://api.satohash.com/*"
  ]
}
