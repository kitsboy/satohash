# Copy to .env on VPS only — never commit real values
NODE_ENV=production
PORT=3001
PUBLIC_API_URL=https://api.satohash.io
CORS_ORIGIN=https://satohash.io,https://satohash.giveabit.io,https://giveabit.io,https://motopass.giveabit.io,https://katoa.org,https://sherpacarta.org,https://stranded.giveabit.io,https://tadbuy.giveabit.io,https://openstrata.giveabit.io

# Open stamp for family MVP (set false + Lightning when billing public API)
REQUIRE_LIGHTNING=false

# Comma-separated family free keys (generate: openssl rand -hex 24)
FAMILY_API_KEYS=change-me-family-key-1

ADMIN_KEY=change-me-min-16-chars
JWT_SECRET=change-me-must-be-at-least-32-characters-long

REDIS_URL=redis://redis:6379
OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com

# Optional VPS pruned bitcoind (verify independence)
# BITCOIN_RPC_URL=http://127.0.0.1:8332/
# BITCOIN_RPC_AUTH=base64(user:pass)

# Optional LND (settlement — not OTS)
# LND_REST_URL=
