# Skip build bump when the commit is docs/status only
if git diff --cached --name-only | grep -qvE '^(docs/|public/docs/|LATEST-UPDATE\.md|\.ai_docs/|README\.md|docs/manifest\.json)$'; then
  npm run version:bump
fi
npm run docs:sync
# Stage every tracked path docs:sync writes (DOC_FILES + PUBLIC_COPY dests)
# so header stamps land in the same commit and the working tree stays clean.
stage_if_tracked() {
  for p in "$@"; do
    if git ls-files --error-unmatch "$p" >/dev/null 2>&1; then
      git add -- "$p"
    fi
  done
}
stage_if_tracked \
  build-metadata.json \
  docs/manifest.json \
  docs/architecture.md \
  docs/ARCHITECTURE.md \
  docs/marketing/EXECUTIVE-SUMMARY.md \
