# Production frontend build — copy to .env.production before npm run build + ./deploy.sh
# Do NOT commit .env.production (secrets / environment-specific)

# API server (set when VPS is live)
VITE_API_URL=https://api.satohash.io

# MVP: public stamp/verify/vault without /access login (default true)
VITE_MVP_MODE=true

VITE_APP_NAME=Satohash
VITE_MEMPOOL_API_URL=https://mempool.space/api
VITE_OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org