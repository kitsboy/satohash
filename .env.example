# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────
# Local dev: Express on 3001. Production build: https://api.satohash.io (see .env.production.example)
VITE_API_URL=http://localhost:3001
VITE_MVP_MODE=true
VITE_APP_NAME=Satohash
VITE_DEFAULT_LANGUAGE=en
VITE_MEMPOOL_API_URL=https://mempool.space/api
VITE_OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
VITE_SENTRY_DSN=

# ─── Security (CHANGE ALL OF THESE IN PRODUCTION) ─────────
# ⚠️  WARNING: Never use default values in production.
# ⚠️  ADMIN_KEY — required for admin login & privileged API routes.
#     Generate: openssl rand -hex 32
#     Server refuses to start in production if unset or contains "change-me".
ADMIN_KEY=change-me-min-16-chars
# ⚠️  JWT_SECRET — signs admin session tokens (24 h expiry).
#     Must be ≥32 random characters. Never commit the real value.
#     Generate: openssl rand -base64 48
#     Server refuses to start in production if unset or contains "change".
JWT_SECRET=change-me-must-be-at-least-32-characters-long
SNAPPER_KEY=change-me-min-32-chars

# ─── CORS ─────────────────────────────────────────────────
# Use * for development, set to your domain in production:
# CORS_ORIGIN=https://satohash.com
CORS_ORIGIN=*

# ─── Bitcoin / OTS ────────────────────────────────────────
# Free open stamps (default). Flip to true when LN invoice backend is live.
REQUIRE_LIGHTNING=false
# STAMP_PRICE_SATS=21

# OTS Calendar servers (free, no signup required)
OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com

# Own Bitcoin node (THOR bitcoind) — enables independent verify plane
# BITCOIN_RPC_URL=http://127.0.0.1:8332/
# BITCOIN_RPC_AUTH=base64(user:pass)
# or: BITCOIN_RPC_USER= + BITCOIN_RPC_PASSWORD=

# Lightning paywall backend (ready before REQUIRE_LIGHTNING=true)
# LNBITS_URL=https://lnbits.example
# LNBITS_INVOICE_KEY=  # invoice/read key — also for HQ Vault display
# LNBITS_ADMIN_KEY=    # optional admin
# LND_HOST=https://127.0.0.1:8080
# LND_MACAROON_PATH=
# LND_REST_URL=

# AI (optional LLM depth; local embeddings + fraud ML always on)
# ANTHROPIC_API_KEY=

# ─── Nostr ────────────────────────────────────────────────
# Hex-encoded private key for the Nostr bot identity.
# If not set, a random key is generated on each restart.
NOSTR_SECRET_KEY=
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social

# ─── Redis (optional — app degrades gracefully without it) ─
REDIS_URL=redis://localhost:6379

# ─── Sentry (optional) ────────────────────────────────────
SENTRY_DSN=

# ─── Email (optional) ─────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── Swagger ──────────────────────────────────────────────
SWAGGER_URL=http://localhost:3001

# ─── Mesh / Peer Network ──────────────────────────────────
NODE_ID=local-witness-1
MESH_SECRET=change-me

# ─── Family free tier (Give A Bit suite) ─────────────────
# Comma-separated keys accepted via X-Satohash-Key header
FAMILY_API_KEYS=
# PUBLIC_API_URL=https://api.satohash.io
# BITCOIN_RPC_URL=

# ─── v5.0.0-ELITE optional ────────────────────────────────
# SATOHASH_DID_PUBLIC_KEY=  # hex for did:web:api.satohash.io (not a secret private key)
# IPFS_PINNING_SERVICE=pinata
# IPFS_API_KEY=change-me
# LND_REST_URL=
# LNBITS_URL=
# GIT_COMMIT=
