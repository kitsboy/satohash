# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Satohash
VITE_DEFAULT_LANGUAGE=en
VITE_MEMPOOL_API_URL=https://mempool.space/api
VITE_OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
VITE_SENTRY_DSN=

# ─── Security (CHANGE ALL OF THESE IN PRODUCTION) ─────────
ADMIN_KEY=change-me-min-16-chars
JWT_SECRET=change-me-must-be-at-least-32-characters-long
SNAPPER_KEY=change-me-min-32-chars

# ─── CORS ─────────────────────────────────────────────────
# Use * for development, set to your domain in production:
# CORS_ORIGIN=https://satohash.com
CORS_ORIGIN=*

# ─── Bitcoin / OTS ────────────────────────────────────────
REQUIRE_LIGHTNING=false

# OTS Calendar servers (free, no signup required)
OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org,https://finney.calendar.eternitywall.com

# ─── Nostr ────────────────────────────────────────────────
# Hex-encoded private key for the Nostr bot identity.
# If not set, a random key is generated on each restart.
NOSTR_SECRET_KEY=

# ─── Redis (optional — app degrades gracefully without it) ─
REDIS_URL=redis://localhost:6379

# ─── Sentry (optional) ────────────────────────────────────
SENTRY_DSN=

# ─── Email (optional) ─────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─── Swagger ──────────────────────────────────────────────
SWAGGER_URL=http://localhost:3001

# ─── Mesh / Peer Network ──────────────────────────────────
NODE_ID=local-witness-1
MESH_SECRET=change-me
