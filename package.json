{
  "name": "satohash",
  "private": true,
  "version": "4.1.0-ELITE",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "production": "cross-env NODE_ENV=production vite build && cross-env NODE_ENV=production npm run server",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "bash deploy.sh",
    "docs:sync": "node scripts/sync-docs.js",
    "prepare": "husky",
    "version:bump": "node scripts/increment-build.js"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
